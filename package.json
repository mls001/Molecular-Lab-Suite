{
  "name": "mls-desktop",
  "version": "26.9.1",
  "description": "Molecular Lab Suite - M.L.S.",
  "author": "mls.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python start.py",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "npm run build:frontend && electron-builder",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf build dist_electron frontend/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.mls.desktop",
    "productName": "Molecular Lab Suite",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/keytar/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "dist/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Molecular Lab Suite"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.science"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Science"
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "xlsx": "^0.18.5"
  }
}
